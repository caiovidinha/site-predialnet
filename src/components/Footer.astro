---
import { FaInstagram } from 'react-icons/fa';
import OptimizedImage from './OptimizedImage.astro';
---

<div class="bg-[#dedede] py-8 font-sans text-[#231f20] px-6 sm:px-[8%] md:px-[12%]">
  <div class="flex flex-col md:flex-row items-center justify-between gap-3">
    <!-- Logo -->
    <div class="flex items-center">
      <OptimizedImage src="/img/logo.png" alt="Predialnet Logo" width={160} height={40} class="h-10" loading="lazy" />
    </div>
    
    <div class="md:hidden">
      <p class="text-xs text-center w-full md:hidden block">
        Rua da Conceição, 188 – sala 3108,
        Centro, Niterói – Rio de Janeiro
        <br />CEP: 24020-080
      </p>
    </div>
    
    <!-- Social Media -->
    <div class="flex space-x-4">
      <a
        href="https://www.instagram.com/predialnet"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#231f20] hover:text-[#9c0004]"
      >
        <FaInstagram size={24} />
      </a>
    </div>

    <!-- Links -->
    <a
      href="/politica-de-privacidade"
      class="text-xs text-[#231f20] hover:text-[#9c0004] underline-offset-2 underline"
    >
      Política de Privacidade
    </a>
    <a
      href="/relatorios"
      class="text-xs text-[#231f20] hover:text-[#9c0004] underline-offset-2 underline"
    >
      Relatórios de Transparência e Igualdade Salarial
    </a>

    <!-- Copyright -->
    <p class="text-center md:text-left text-xs text-[#231f20] w-full md:w-auto">
      Predialnet - Provedor de Internet &copy; 2025 Todos os direitos reservados.
    </p>

    <!-- Developed by -->
    <p class="text-center md:text-left text-xs text-[#231f20] w-full md:w-auto">
      Site desenvolvido por Jump IMKT
    </p>
  </div>
  
  <div>
    <p class="mt-5 text-xs text-center w-full hidden md:block">
      Rua da Conceição, 188 – sala 3108,
      Centro, Niterói – Rio de Janeiro
      CEP: 24020-080
    </p>
  </div>
</div>
