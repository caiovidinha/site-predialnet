---
import { EMPRESA } from '../data/site.js';

const { razaoSocial, cnpj, endereco, anoFundacao } = EMPRESA;
const enderecoCompleto = `${endereco.logradouro}, ${endereco.bairro}, ${endereco.cidade} - ${endereco.uf} - CEP: ${endereco.cep}`;
---

<footer class="font-sans text-[#3d3838]">
  <!-- Área principal do rodapé -->
  <div class="bg-[#f0f0f0] px-6 sm:px-[8%] md:px-[12%] py-10">
    <div class="flex flex-col md:flex-row items-start gap-8">

      <!-- Imagem lateral (metade da seção) -->
      <div class="md:w-1/2 h-auto shrink-0 md:self-stretch">
        <picture>
          <source media="(min-width: 768px)" srcset="/img/rodape.webp" />
          <img src="/img/rodape_mobile_b.webp" alt="Central de atendimento Predialnet" width="900" height="244" class="w-full h-full object-cover rounded-md md:grayscale" loading="lazy" decoding="async" />
        </picture>
      </div>

      <!-- Links -->
      <div class="flex-1 grid grid-cols-2 gap-4 md:gap-6">

        <!-- Links coluna 1 -->
        <div class="flex flex-col gap-4 text-sm text-left md:text-right">
          <a href="https://minhaconta.predialnet.com.br" target="_blank" rel="noopener noreferrer" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Minha conta</a>
          <a href="https://webmail.predialnet.com.br/index.php" target="_blank" rel="noopener noreferrer" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Webmail</a>
          <a href="/#Plans" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Planos de internet</a>
          <a href="/#Telefone" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Planos de telefonia</a>
          <a href="/#App" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">App Minha Predialnet</a>
        </div>

        <!-- Links coluna 2 -->
        <div class="flex flex-col gap-4 text-sm text-left md:text-right">
          <a href="/politica-de-privacidade" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Política de Privacidade</a>
          <a href="/relatorios" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Relatórios de Transparência<br />e Igualdade Salarial</a>
          <a href="https://www.consumidor.gov.br/pages/conteudo/publico/102" target="_blank" rel="noopener noreferrer" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Código de defesa do consumidor</a>
          <a href="/documentos" class="text-[#555] underline md:no-underline hover:text-[#9c0004]">Regulamentos e contratos</a>
        </div>

      </div>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="bg-[#f0f0f0] px-6 sm:px-[8%] md:px-[12%]">
    <hr class="border-t border-[#b0b0b0]" />
    <div class="py-10 hidden md:flex flex-col md:flex-row items-center justify-between gap-3 ">
      <div class="text-xs text-[#555] leading-relaxed">
        <p>{razaoSocial} CNPJ: {cnpj}</p>
        <p>{enderecoCompleto}</p>
        <p>Provedor de internet por fibra óptica em Niterói, São Gonçalo, Itaboraí e Rio de Janeiro desde {anoFundacao}.</p>
        <p>Todos os direitos reservados. ©2026 &nbsp;·&nbsp; Site desenvolvido por Jump Marketing</p>
      </div>
      <img src="/img/logo-fibra.png" alt="Predialnet Fibra" class="h-8 object-contain" loading="lazy" width="1079" height="316" decoding="async" />
    </div>
    <div class="pt-5 pb-10 flex md:hidden flex-col md:flex-row items-center justify-between gap-3 ">
      <div class="text-[7px] md:text-xs text-[#555] leading-relaxed">
        <p>{razaoSocial} CNPJ: {cnpj}
        - {enderecoCompleto} - Provedor de internet por fibra óptica em Niterói, São Gonçalo, Itaboraí e Rio de Janeiro desde {anoFundacao}. Todos os direitos reservados. ©2026 &nbsp;·&nbsp; Site desenvolvido por Jump Marketing</p>
      </div>
      <img src="/img/logo-fibra.png" alt="Predialnet Fibra" class="hidden md:block h-8 object-contain" loading="lazy" width="1079" height="316" decoding="async" />
    </div>
  </div>
</footer>
