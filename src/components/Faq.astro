---
/**
 * FAQ visível da home.
 *
 * Lê de src/data/faq.js — a mesma fonte que alimenta o FAQPage do Schema.org
 * no Layout. O Google exige que o conteúdo marcado esteja visível na página,
 * então as duas coisas precisam sair do mesmo lugar.
 *
 * Usa <details>/<summary> nativos: acessível por teclado e sem JavaScript,
 * então o texto das respostas está no HTML mesmo com o item fechado — que é
 * o que buscadores e mecanismos de IA leem.
 */
import { FAQ_HOME } from '../data/faq.js';

interface Props {
  titulo?: string;
  subtitulo?: string;
  itens?: { pergunta: string; resposta: string }[];
}

const {
  titulo = 'Perguntas frequentes sobre internet',
  subtitulo = 'As dúvidas que mais chegam ao nosso atendimento',
  itens = FAQ_HOME,
} = Astro.props;
---

<section
  id="faq"
  class="px-6 sm:px-[8%] md:px-[12%] pt-10 pb-8 md:pb-14 font-sans bg-[#ebebeb] text-[#3d3838]"
  aria-labelledby="faq-titulo"
>
  <h2 id="faq-titulo" class="text-[1.65rem] md:text-3xl leading-8 mb-1 tracking-[-0.01em]">
    {titulo}
  </h2>
  <p class="text-lg font-light leading-6 mb-5 md:mb-8">{subtitulo}</p>

  <div class="flex flex-col gap-2">
    {itens.map((item) => (
      <details class="group bg-white border border-[#dcdcdc] rounded">
        <summary
          class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4 text-sm md:text-base font-normal hover:text-[#8a0005] transition-colors"
        >
          <h3 class="font-normal text-[0.95rem] md:text-base leading-snug">{item.pergunta}</h3>
          <svg
            class="w-4 h-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="px-5 pb-5 -mt-1 text-sm font-light leading-relaxed text-[#555]">
          {item.resposta}
        </p>
      </details>
    ))}
  </div>
</section>

<style>
  /* Esconde o marcador nativo do <summary> no Safari e no Chrome */
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
</style>
