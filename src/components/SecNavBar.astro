---
// SecNavBar Component
const { showBanner = false } = Astro.props;
---

<!-- Desktop (hidden) -->
<nav class="hidden"></nav>

<!-- Mobile Banner -->
{showBanner && (
  <div class="sm:hidden">
    <a href="https://www.predialnet.com.br/assineja?plano=1gigacopa" target="_blank" rel="noopener noreferrer">
      <img src="/img/bannerMobile.avif" alt="Predialnet" class="w-full h-auto block" loading="eager" />
    </a>
  </div>
)}

