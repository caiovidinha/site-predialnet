---
// SecNavBar Component
import OptimizedImage from './OptimizedImage.astro';
---

<!-- Versão Desktop -->
<nav class="hidden sm:flex py-3 px-6 sm:px-[8%] md:px-[12%] font-sans font-thin duration-300 transition-all justify-between flex-row bg-[#f3f3f3]">
  <div class="w-full flex gap-8 items-center justify-start">
    <a
      class="text-[#9e9e9e] hover:text-[#9c0004] hover:border-b-2 transition-all border-[#9c0004] font-semibold"
      href="/#Plans"
    >
      Planos
    </a>
    <a
      class="text-[#9e9e9e] hover:text-[#9c0004] hover:border-b-2 transition-all border-[#9c0004] font-semibold"
      href="/#WiFi6"
    >
      Wi-Fi 6
    </a>
    <a
      class="text-[#9e9e9e] hover:text-[#9c0004] hover:border-b-2 transition-all border-[#9c0004] font-semibold"
      href="/#Telefone"
    >
      Telefonia Fixa
    </a>
    <a
      class="text-[#9e9e9e] hover:text-[#9c0004] hover:border-b-2 transition-all border-[#9c0004] font-semibold"
      href="https://webmail.predialnet.com.br/index.php"
      target="_blank"
    >
      Webmail
    </a>
  </div>
  <div class="w-full flex items-center justify-end gap-3">
    <div class="font-semibold text-black">
      Assine também pelo telefone 21 3515-0555
    </div>
    <a
      target="_blank"
      class="p-2 bg-[#00a300] inline-block rounded-full text-xs font-medium uppercase leading-normal shadow-md transition duration-150 ease-in-out hover:shadow-lg focus:shadow-lg focus:outline-none focus:ring-0 active:shadow-lg hover:scale-105"
      href="https://api.whatsapp.com/send?phone=5521977287782&text=Ol%C3%A1!%20Estou%20entrando%20em%20contato%20atrav%C3%A9s%20do%20site%20da%20Predialnet."
      rel="noopener noreferrer"
      aria-label="Conversar no WhatsApp"
    >
      <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
    <a
      target="_blank"
      class="text-black font-semibold bg-[#f7adaf] text-sm px-8 py-2.5 rounded-full hover:scale-105 transition-transform"
      href="https://www.predialnet.com.br/assineja"
      rel="noopener noreferrer"
    >
      Assinar Agora!
    </a>
  </div>
</nav>

<!-- Versão Mobile -->
<nav class="sm:hidden pb-0 bg-white flex items-center justify-between flex-wrap gap-2">
  <!-- Botões Assine e Contato -->
  <div class="py-3 flex items-center space-x-2 w-full bg-[#f3f3f3] justify-between px-6">
    <a
      href="https://www.predialnet.com.br/assineja"
      target="_blank"
      class="bg-[#f7adaf] text-xs px-4 py-1.5 rounded-full font-semibold whitespace-nowrap hover:scale-105 transition-transform"
    >
      Assinar pelo site
    </a>
    <a
      href="tel:02135150555"
      class="border border-black px-4 py-1.5 rounded-full font-semibold text-xs whitespace-nowrap"
    >
      ou pelo telefone 3515-0555
    </a>
    <a href="https://minhaconta.predialnet.com.br" target="_blank" rel="noopener noreferrer">
      <OptimizedImage
        src="/img/icone_profile.png"
        alt="Perfil"
        width={28}
        height={32}
        class="w-7 h-8 mt-1 object-contain"
        loading="lazy"
      />
    </a>
  </div>

  <!-- Ícones em uma linha, com fundo branco e espaçamento uniforme -->
  <div class="w-full bg-white pt-1 pb-2 flex justify-between px-6">
    <a
      href="/#Plans"
      class="flex flex-col items-center hover:scale-105 transition-transform w-1/4"
    >
      <OptimizedImage src="/img/iconePlanos.png" alt="Planos Internet" width={40} height={40} class="w-10 h-10 mb-0" loading="lazy" />
      <p class="text-xs text-center whitespace-pre-wrap leading-tight px-2">Planos<br />Internet</p>
    </a>
    <a
      href="/#Telefone2"
      class="flex flex-col items-center hover:scale-105 transition-transform w-1/4"
    >
      <OptimizedImage src="/img/iconeTelefonia.png" alt="Telefonia Fixa" width={40} height={40} class="w-10 h-10 mb-0" loading="lazy" />
      <p class="text-xs text-center whitespace-pre-wrap leading-tight px-2">Telefonia<br />Fixa</p>
    </a>
    <a
      href="/#Cliente2"
      class="flex flex-col items-center hover:scale-105 transition-transform w-1/4"
    >
      <OptimizedImage src="/img/iconeAcesso.png" alt="Suporte rápido" width={40} height={40} class="w-10 h-10 mb-0" loading="lazy" />
      <p class="text-xs text-center whitespace-pre-wrap leading-tight px-2">Suporte<br />rápido</p>
    </a>
    <a
      href="https://webmail.predialnet.com.br/index.php"
      target="_blank"
      class="flex flex-col items-center hover:scale-105 transition-transform w-1/4"
    >
      <OptimizedImage src="/img/iconeWebmail.png" alt="Acessar Webmail" width={40} height={40} class="w-10 h-10 mb-0" loading="lazy" />
      <p class="text-xs text-center whitespace-pre-wrap leading-tight px-2">Acessar Webmail</p>
    </a>
  </div>
</nav>
