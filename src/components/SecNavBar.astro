---
// SecNavBar Component
const { showBanner = false } = Astro.props;
---

<!-- Desktop (hidden) -->
<nav class="hidden"></nav>

<!-- Mobile Banner -->
{showBanner && (
  <div class="sm:hidden">
    <img src="/img/bannerMobile.avif" alt="Planos de internet fibra óptica Predialnet de 600 Mega a 1 Giga" class="w-full h-auto block" width="1920" height="1422" loading="eager" fetchpriority="high" decoding="async" />
  </div>
)}

