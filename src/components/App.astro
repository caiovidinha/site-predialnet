---
// App Component
import OptimizedImage from './OptimizedImage.astro';
---

<>
  <!-- Desktop Version -->
  <div id="App" class="hidden md:flex px-6 sm:px-[8%] md:px-[12%] py-10 font-sans bg-white flex-row justify-between">
    <div class="w-[21%] flex flex-col justify-end mb-14">
      <h3 class="text-[#9c0004] text-lg">App Minha Predialnet</h3>
      <h1 class="text-3xl my-7 w-full text-[#3d3838]">
        Acesse o App<br />Minha Predialnet e gerencie seu plano na palma da mão
      </h1>
      <img
        src="/img/qrcode.png"
        alt="QR Code"
        class="border-[#dbdbdb] border-2 rounded-lg border-solid w-52"
      />
    </div>

    <img src="/img/appbanner.png" class="w-[45%] h-full" alt="App Banner" />

    <div class="justify-end min-h-full w-[21%] gap-3 flex flex-col mb-14">
      <p class="text-[#555] text-xl">
        Tudo que você precisa para gerenciar sua conta. 2ª via de fatura, mudança de plano,
        suporte, financeiro e muito mais.
      </p>
      <div class="w-full border-t-2 border-gray-400 mt-3" />
      <p class="text-[#555] text-lg flex items-center gap-3">
        <img src="/img/iconePerfil.png" alt="Perfil" class="w-4 h-4" />Perfil
      </p>
      <div class="w-full border-t-2 border-gray-400" />
      <p class="text-[#555] text-lg flex items-center gap-3">
        <OptimizedImage src="/img/iconeFatura.png" alt="Financeiro" width={16} height={16} class="w-4 h-4" loading="lazy" />Financeiro
      </p>
      <div class="w-full border-t-2 border-gray-400" />
      <p class="text-[#555] text-lg flex items-center gap-3">
        <OptimizedImage src="/img/iconeAjuda.png" alt="Suporte" width={16} height={16} class="w-4 h-4" loading="lazy" />Suporte
      </p>
      <div class="w-full border-t-2 border-gray-400" />
      <p class="text-[#555] text-lg flex items-center gap-3">
        <OptimizedImage src="/img/iconeSuporte.png" alt="Opções" width={16} height={16} class="w-4 h-4" loading="lazy" />Opções
      </p>
      <div class="w-full border-t-2 border-gray-400" />

      <div class="flex flex-row justify-between mt-5">
        <a
          href="https://apps.apple.com/br/app/minha-predialnet/id6743764762"
          target="_blank"
          rel="noopener noreferrer"
        >
          <OptimizedImage src="/img/logoappstore.png" alt="Baixar na App Store" width={120} height={35} class="h-full cursor-pointer" loading="lazy" />
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=com.predialnet.app"
          target="_blank"
          rel="noopener noreferrer"
        >
          <OptimizedImage src="/img/logogoogleplay.png" alt="Baixar no Google Play" width={120} height={35} class="h-full cursor-pointer" loading="lazy" />
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Version -->
  <div id="App2" class="md:hidden px-6 py-10 font-sans bg-white">
    <div class="flex flex-col items-start">
      <h3 class="text-[#9c0004] text-lg text-left">App Minha Predialnet</h3>
      <h1 class="text-3xl my-4 text-left text-[#3d3838]">
        Acesse o App Minha Predialnet e gerencie seu plano na palma da mão
      </h1>
      <p class="text-[#555] text-lg text-left mb-6 leading-6">
        Tudo que você precisa para gerenciar sua conta. 2ª via de fatura, mudança de plano,
        suporte, financeiro e muito mais.
      </p>
      <OptimizedImage src="/img/appbanner.png" alt="App Minha Predialnet" width={800} height={800} class="w-full mb-6" loading="lazy" />
      
      <div class="flex flex-row justify-center gap-3 w-full mt-2">
        <a
          href="https://apps.apple.com/br/app/minha-predialnet/id6743764762"
          target="_blank"
          rel="noopener noreferrer"
        >
          <OptimizedImage
            src="/img/logoappstore.png"
            alt="Baixar na App Store"
            width={120}
            height={35}
            class="h-auto cursor-pointer transition-transform active:scale-95"
            loading="lazy"
          />
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=com.predialnet.app"
          target="_blank"
          rel="noopener noreferrer"
        >
          <OptimizedImage
            src="/img/logogoogleplay.png"
            alt="Baixar no Google Play"
            width={120}
            height={35}
            class="h-auto cursor-pointer transition-transform active:scale-95"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>
</>
