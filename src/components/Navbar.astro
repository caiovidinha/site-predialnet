---
// Navbar Component
import OptimizedImage from './OptimizedImage.astro';
---

<>
  <!-- Desktop Navbar -->
  <nav class="hidden sm:flex items-end gap-6 pt-5 pb-3 px-6 sm:px-[8%] md:px-[12%] font-sans bg-[#f3f3f3] text-[13px] text-[#575757]">
    <!-- Logo -->
    <a href="/" class="shrink-0 mr-4 pb-0.5">
      <OptimizedImage
        src="/img/logo.png"
        width={150}
        height={38}
        class="hover:scale-[101%] duration-100 ease-in hover:cursor-pointer"
        alt="Predialnet Logo"
        loading="eager"
      />
    </a>

    <!-- Nav links -->
    <div class="flex gap-6 items-end mb-[3px]">
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="/#Plans">Internet</a>
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="/#Telefone">Telefonia fixa</a>
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="https://webmail.predialnet.com.br/index.php" target="_blank" rel="noopener noreferrer">Webmail</a>
    </div>

    <!-- Spacer left -->
    <div class="flex-1"></div>

    <!-- Phone CTA -->
    <span class="whitespace-nowrap mb-[3px]">Assine agora 21 3515-0555</span>

    <!-- Spacer right -->
    <div class="flex-1"></div>

    <!-- Anatel badge -->
    <a href="/anatel" class="flex items-center gap-1.5 whitespace-nowrap mb-[3px] hover:text-[#8c0005] transition-all group">
      <span>Provedor Licenciado</span>
      <img src="/img/anatel.png" alt="Anatel" class="h-4 object-contain mb-[5px] transition-opacity group-hover:opacity-80" loading="eager" />
    </a>

    <!-- Já sou cliente -->
    <a
      href="https://minhaconta.predialnet.com.br"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-end gap-1 ml-2 group mb-[3px]"
      aria-label="Acessar área do cliente"
    >
      <svg class="w-[20px] h-[20px] text-[#575757] group-hover:text-[#9c0004] transition-colors ease-in duration-150 mb-px" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="group-hover:text-[#9c0004] transition-colors ease-in duration-150 shrink-0">Minha conta</span>
    </a>
  </nav>

  <!-- Mobile Navbar -->
  <nav class="sm:hidden px-6 sm:px-[8%] md:px-[12%] py-3 font-sans bg-[#f3f3f3] border-b-2 border-gray-200 flex items-end justify-between">
    <a href="/">
      <OptimizedImage
        src="/img/logo.png"
        width={134}
        height={32}
        alt="Predialnet Logo"
        class="h-8 object-contain"
        loading="eager"
      />
    </a>

  <a href="https://minhaconta.predialnet.com.br" target="_blank" rel="noopener noreferrer">
      <OptimizedImage
        src="/img/icone_profile.png"
        alt="Perfil"
        width={28}
        height={32}
        class="w-6 h-7 -mb-2 object-contain"
        loading="lazy"
      />
    </a>
  </nav>

  <!-- WhatsApp Floating Button -->
  <a
    href="https://api.whatsapp.com/send?phone=5521977287782&text=Ol%C3%A1!%20Estou%20entrando%20em%20contato%20atrav%C3%A9s%20do%20site%20da%20Predialnet."
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-4 right-4 p-3 bg-[#00a650] rounded-full shadow-lg hover:scale-105 transition-transform z-50"
    aria-label="Conversar no WhatsApp"
  >
    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
</>
