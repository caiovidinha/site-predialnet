---
// Navbar Component
import { FaInstagram } from 'react-icons/fa';
import OptimizedImage from './OptimizedImage.astro';
---

<>
  <!-- Desktop Navbar -->
  <nav class="hidden sm:flex pb-2 py-2 px-6 sm:px-[8%] md:px-[12%] font-sans font-thin duration-300 transition-all border-b-[2.5px] border-solid border-[#e3e3e3] items-center justify-between flex-row bg-[#f3f3f3]">
    <div class="flex justify-between gap-8 items-center w-full">
      <a href="/">
        <OptimizedImage
          src="/img/logo.png"
          width={200}
          height={50}
          class="hover:scale-105 duration-300 ease-in hover:cursor-pointer"
          alt="Predialnet Logo"
          loading="eager"
        />
      </a>
      <ul class="flex space-x-4 justify-start items-center w-full mt-4 gap-4 tracking-normal h-full">
        <li>
          <a href="/">
            <p class="text-[#9c0004] text-sm font-semibold duration-150 ease-in-out border-b-[#9c0004] border-solid border-b-2 h-full">
              Para sua casa
            </p>
          </a>
        </li>
      </ul>
    </div>
    <div id="buttons" class="flex w-80 items-center justify-end">
      <div class="flex items-center justify-start gap-3">
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-[#9c0004] inline-block rounded-full text-xs font-medium uppercase leading-normal shadow-md transition duration-150 ease-in-out hover:shadow-lg focus:shadow-lg focus:outline-none focus:ring-0 active:shadow-lg hover:scale-105"
          href="https://instagram.com/predialnet"
          aria-label="Seguir Predialnet no Instagram"
        >
          <FaInstagram className="relative" color="white" size={20} aria-hidden="true" />
        </a>
      </div>
      <div class="max-w-0.5 min-h-8 mx-4 bg-[#e3e3e3] p-[0.8px]"></div>
      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex text-right items-center justify-end gap-2 flex-row text-sm rounded-lg text-black font-bold font-sans mt-4"
        aria-label="Acessar área do cliente"
      >
      <p class="hover:border-b-2 border-[#9c0004] transition-all ease-in-out duration-100">
          Já sou cliente
        </p>
        <OptimizedImage
          src="/img/icone_profile.png"
          width={24}
          height={24}
          class="w-6 h-6 object-contain"
          alt="Perfil"
          loading="eager"
        />
        
      </a>
    </div>
  </nav>

  <!-- Mobile Navbar -->
  <nav class="sm:hidden px-6 py-3 font-sans bg-[#f3f3f3] border-b-2 border-gray-200 flex items-center justify-between">
    <a href="/">
      <OptimizedImage
        src="/img/logo.png"
        width={160}
        height={32}
        alt="Predialnet Logo"
        class="h-8 object-contain"
        loading="eager"
      />
    </a>

    <div class="flex items-end mt-3 space-x-2">
      <a href="/">
        <p class="text-[#9c0004] text-xs font-semibold whitespace-nowrap">
          Para sua casa
        </p>
      </a>
    </div>

    <!-- WhatsApp Floating Button -->
    <a
      href="https://api.whatsapp.com/send?phone=5521977287782&text=Ol%C3%A1!%20Estou%20entrando%20em%20contato%20atrav%C3%A9s%20do%20site%20da%20Predialnet."
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-4 right-4 p-3 bg-[#00a300] rounded-full shadow-lg hover:scale-105 transition-transform z-50"
      aria-label="Conversar no WhatsApp"
    >
      <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </nav>
</>
