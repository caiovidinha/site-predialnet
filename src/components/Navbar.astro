---
// Navbar Component
import OptimizedImage from './OptimizedImage.astro';
---

<>
  <!-- Desktop Navbar -->
  <nav class="hidden sm:flex items-end gap-6 pt-5 pb-3 px-6 sm:px-[8%] md:px-[12%] font-sans bg-[#f3f3f3] text-[13px] text-[#575757]">
    <!-- Logo -->
    <a href="/" class="shrink-0 mr-4 pb-0.5">
      <OptimizedImage
        src="/img/logo.png"
        width={150}
        height={38}
        class="hover:scale-[101%] duration-100 ease-in hover:cursor-pointer"
        alt="Predialnet Logo"
        loading="eager"
      />
    </a>

    <!-- Nav links -->
    <div class="flex gap-6 items-end mb-[3px]">
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="/#Plans">Internet</a>
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="/#Telefone">Telefonia fixa</a>
      <a class="hover:text-[#9c0004] transition-colors ease-in duration-150" href="https://webmail.predialnet.com.br/index.php" target="_blank" rel="noopener noreferrer">Webmail</a>
    </div>

    <!-- Spacer left -->
    <div class="flex-1"></div>

    <!-- Phone CTA -->
    <span class="whitespace-nowrap mb-[3px]">Assine agora 21 3515-0555</span>

    <!-- Spacer right -->
    <div class="flex-1"></div>

    <!-- Anatel badge -->
    <a href="/anatel" class="flex items-center gap-1.5 whitespace-nowrap mb-[3px] hover:text-[#8c0005] transition-all group">
      <span>Provedor Licenciado</span>
      <img src="/img/anatel.png" alt="Anatel" class="h-4 object-contain mb-[5px] transition-opacity group-hover:opacity-80" loading="eager" />
    </a>

    <!-- Já sou cliente -->
    <a
      href="https://minhaconta.predialnet.com.br"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-end gap-1 ml-2 group mb-[3px]"
      aria-label="Acessar área do cliente"
    >
      <svg class="w-[20px] h-[20px] text-[#575757] group-hover:text-[#9c0004] transition-colors ease-in duration-150 mb-px" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="group-hover:text-[#9c0004] transition-colors ease-in duration-150 shrink-0">Minha conta</span>
    </a>
  </nav>

  <!-- Mobile Navbar -->
  <nav class="sm:hidden px-6 pt-7 pb-3 font-sans bg-[#f3f3f3] border-b-2 border-gray-200 grid grid-cols-3 items-end">
    <!-- Col 1: Logo -->
    <a href="/">
      <OptimizedImage
        src="/img/logo.png"
        width={90}
        height={22}
        alt="Predialnet Logo"
        class="h-[22px] object-contain"
        loading="eager"
      />
    </a>

    <!-- Col 2: App button — empurrado para direita -->
    <div class="flex justify-end">
      <a href="/redirect" class="text-[11px] text-[#575757] border -mr-10 border-[#aaaaaa] px-2.5 py-1 rounded-full whitespace-nowrap hover:border-[#9c0004] hover:text-[#9c0004] transition-colors -mb-1">
        Baixe o App Minha Predialnet
      </a>
    </div>

    <!-- Col 3: Minha conta + hamburger — right-aligned -->
    <div class="flex justify-end items-end gap-2">
      <a href="https://minhaconta.predialnet.com.br" target="_blank" rel="noopener noreferrer" aria-label="Minha conta" class="-mb-2">
        <OptimizedImage
          src="/img/icone_profile.png"
          alt="Perfil"
          width={28}
          height={32}
          class="w-6 h-7 object-contain"
          loading="lazy"
        />
      </a>
      <button onclick="openMobileMenu()" aria-label="Abrir menu" class="p-1 -mb-2">
        <svg class="w-6 h-6 text-[#575757]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Side Drawer -->
  <div id="mobile-drawer" class="sm:hidden fixed inset-0 z-[100] invisible" role="dialog" aria-modal="true" aria-label="Menu de navegação">
    <div id="drawer-overlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300" onclick="closeMobileMenu()"></div>
    <div id="drawer-panel" class="absolute left-0 top-0 h-full w-[75vw] max-w-[300px] bg-white shadow-2xl -translate-x-full transition-transform duration-300 flex flex-col">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <img src="/img/logo.avif" alt="Predialnet" class="h-6 object-contain" loading="eager" />
        <button onclick="closeMobileMenu()" aria-label="Fechar menu" class="p-1">
          <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="flex flex-col px-5 py-4 text-[#575757] font-sans text-base">
        <a href="https://webmail.predialnet.com.br/index.php" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 py-4 border-b border-gray-100 hover:text-[#9c0004] transition-colors"
           onclick="closeMobileMenu()">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          Webmail
        </a>
        <a href="/#ClienteAtendimento"
           class="flex items-center gap-3 py-4 border-b border-gray-100 hover:text-[#9c0004] transition-colors"
           onclick="closeMobileMenu()">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          Acesso rápido
        </a>
        <a href="/#Telefone"
           class="flex items-center gap-3 py-4 hover:text-[#9c0004] transition-colors"
           onclick="closeMobileMenu()">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Telefonia fixa
        </a>
      </nav>
    </div>
  </div>

  <script is:inline>
    function openMobileMenu() {
      const drawer = document.getElementById('mobile-drawer');
      const overlay = document.getElementById('drawer-overlay');
      const panel = document.getElementById('drawer-panel');
      drawer.classList.remove('invisible');
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        overlay.classList.add('opacity-100');
        panel.classList.remove('-translate-x-full');
        panel.classList.add('translate-x-0');
      });
    }
    function closeMobileMenu() {
      const overlay = document.getElementById('drawer-overlay');
      const panel = document.getElementById('drawer-panel');
      const drawer = document.getElementById('mobile-drawer');
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      panel.classList.remove('translate-x-0');
      panel.classList.add('-translate-x-full');
      setTimeout(() => drawer.classList.add('invisible'), 300);
    }
  </script>

  <!-- WhatsApp Floating Button -->
  <a
    href="https://api.whatsapp.com/send?phone=5521977287782&text=Ol%C3%A1!%20Estou%20entrando%20em%20contato%20atrav%C3%A9s%20do%20site%20da%20Predialnet."
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-4 right-4 p-3 bg-[#00a650] rounded-full shadow-lg hover:scale-105 transition-transform z-50"
    aria-label="Conversar no WhatsApp"
  >
    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
</>
