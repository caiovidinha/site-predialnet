  <script is:inline>
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    const mainContent = document.getElementById('mainContent');
    const noResults = document.getElementById('noResults');

    if (!searchInput || !mainContent || !noResults) {
      console.error('Required elements not found');
    } else {
      searchInput.addEventListener('input', (e) => {
        if (!e.target) return;
        const searchTerm = e.target.value.toLowerCase().trim();
        
        if (searchTerm === '') {
          // Show all content
          const allSections = mainContent.querySelectorAll('.day-section, .region-section, .block-card');
          allSections.forEach(section => section.classList.remove('hidden'));
          mainContent.classList.remove('hidden');
          noResults.classList.add('hidden');
          return;
        }

        let hasResults = false;

        // Search through all day sections
        const daySections = mainContent.querySelectorAll('.day-section');
        
        daySections.forEach(daySection => {
          let dayHasResults = false;
          const regionSections = daySection.querySelectorAll('.region-section');
          
          regionSections.forEach(regionSection => {
            let regionHasResults = false;
            const blockCards = regionSection.querySelectorAll('.block-card');
            
            blockCards.forEach(blockCard => {
              const blockNameEl = blockCard.querySelector('.block-name');
              const blockLocationEl = blockCard.querySelector('.block-location');
              
              if (!blockNameEl || !blockLocationEl) return;
              
              const blockName = blockNameEl.textContent?.toLowerCase() || '';
              const blockLocation = blockLocationEl.textContent?.toLowerCase() || '';
              const regionName = (regionSection instanceof HTMLElement && regionSection.dataset?.region ? regionSection.dataset.region : '').toLowerCase();
              
              if (blockName.includes(searchTerm) || 
                  blockLocation.includes(searchTerm) || 
                  regionName.includes(searchTerm)) {
                blockCard.classList.remove('hidden');
                regionHasResults = true;
                hasResults = true;
              } else {
                blockCard.classList.add('hidden');
              }
            });
            
            if (regionHasResults) {
              regionSection.classList.remove('hidden');
              dayHasResults = true;
            } else {
              regionSection.classList.add('hidden');
            }
          });
          
          if (dayHasResults) {
            daySection.classList.remove('hidden');
          } else {
            daySection.classList.add('hidden');
          }
        });

        // Show/hide no results message
        if (hasResults) {
          mainContent.classList.remove('hidden');
          noResults.classList.add('hidden');
        } else {
          mainContent.classList.add('hidden');
          noResults.classList.remove('hidden');
        }
      });
    }

    // Smooth scroll animation on load
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.day-section');
      sections.forEach((section, index) => {
        if (section instanceof HTMLElement) {
          section.style.animationDelay = `${index * 0.1}s`;
        }
      });
    });
  </script>

