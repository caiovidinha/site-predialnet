                href={doc.link}
                target="_blank"
                rel="noopener noreferrer"
                class="md:ml-2 text-xs text-[#8a0005] hover:underline underline-offset-2 transition-opacity"
              >
                Download PDF
              </a>
            </p>
          </div>
        ))}
