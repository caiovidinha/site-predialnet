---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SecNavBar from '../components/SecNavBar.astro';
import Plans from '../components/Plans';
import PromoCarousel from '../components/PromoCarousel';
import IdealPlans from '../components/IdealPlans';
import NavegaSection from '../components/NavegaSection';
import Contrate from '../components/Contrate';
import TelefoniaSection from '../components/TelefoniaSection';
import Others from '../components/Others';
import ClienteAtendimento from '../components/ClienteAtendimento';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Predialnet"
  description="Internet fibra óptica da Predialnet com planos de 600 Mega a 1 Giga, Wi-Fi 6, instalação grátis e sem fidelidade. Maior provedor regional do Rio de Janeiro."
>
  <Navbar />
  <SecNavBar showBanner />
  <h1 class="sr-only">
    Internet fibra óptica em Niterói, São Gonçalo e Rio de Janeiro
  </h1>
  <a href="https://www.predialnet.com.br/assineja?plano=hero" target="_blank" rel="noopener noreferrer" class="hidden sm:block">
    <img src="/img/hero.webp" alt="Planos de internet fibra óptica Predialnet de 600 Mega a 1 Giga" class="w-full h-auto block" width="2560" height="722" loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <Plans client:load />
  <PromoCarousel client:visible />
  <IdealPlans client:visible />
  <div id="App"></div>
  <PromoCarousel
    client:visible
    title="Facilite sua vida, baixe o App Minha Predialnet"
    subtitle="Gerenciamento completo do seu plano"
    slides={[
      { src: '/img/carrossel-c.webp', mobileSrc: '/img/carrossel-c-mobile.webp', alt: 'App Minha Predialnet para gerenciar seu plano', link: '', mobileLink: '/redirect', w: 1920, h: 470 },
    ]}
  />
  <NavegaSection client:visible />
  <PromoCarousel
    client:visible
    title="O maior provedor regional do Estado do Rio de Janeiro"
    subtitle="Agora sua internet vai ser gigante, venha para Predialnet."
    slides={[
      { src: '/img/carrossel-e.webp', mobileSrc: '/img/carrossel-e-mobile.webp', alt: 'Predialnet, provedor regional de internet no Estado do Rio de Janeiro', link: '', mobileLink: '', w: 2560, h: 626 },
      { src: '/img/carrossel-d.webp', mobileSrc: '/img/carrossel-d-mobile.webp', alt: 'Predialnet, patrocinadora do Fluminense Football Club', link: '', mobileLink: '', w: 1920, h: 470 },
    ]}
  />
  <TelefoniaSection client:visible />
  <Others client:visible />
  <ClienteAtendimento client:visible />
  <Plans imageCard="/img/cardPlanosB.webp" client:visible />
  <Contrate client:visible />
  <Footer />
</Layout>
