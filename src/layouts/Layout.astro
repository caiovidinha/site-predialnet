---
import '../styles/global.css';
import { SITE, EMPRESA, HORARIOS, CIDADES, PLANOS, PRECO_MIN, PRECO_MAX } from '../data/site.js';

interface FaqItem { pergunta: string; resposta: string; }
interface Crumb { nome: string; url: string; }

interface Props {
  title?: string;
  description?: string;
  /** Imagem de compartilhamento (Open Graph). Caminho relativo à raiz. */
  image?: string;
  /** Páginas utilitárias (formulários, redirects) não devem ser indexadas. */
  noindex?: boolean;
  /** Perguntas e respostas desta página — vira FAQPage no Schema.org. */
  faq?: FaqItem[];
  /** Trilha de navegação real desta página. A home não passa nada. */
  breadcrumbs?: Crumb[];
}

const {
  title = 'Predialnet — Internet fibra óptica em Niterói, São Gonçalo e Rio de Janeiro',
  description = 'Provedor de internet por fibra óptica com planos de 600 Mega a 1 Giga, Wi-Fi 6, instalação grátis e sem fidelidade. Atende Niterói, São Gonçalo, Itaboraí e Rio de Janeiro.',
  image = '/img/og-predialnet.jpg',
  noindex = false,
  faq = [],
  breadcrumbs = [],
} = Astro.props;

const base = Astro.site ?? new URL(SITE);
// O Apache serve as páginas com barra final (/via-radio -> 301 -> /via-radio/).
// O canonical aponta para a URL que responde 200, sem passar por redirect.
const semBarra = Astro.url.pathname.replace(/[/]+$/, '');
const pathname = semBarra === '' ? '/' : semBarra + '/';
const canonical = new URL(pathname, base).href;
const ogImage = new URL(image, base).href;

const SHOW_CARNAVAL_POPUP = false;
const SHOW_INSTABILITY_POPUP = false;
const SHOW_FRAUD_POPUP = false;

/* ─── Schema.org montado a partir de src/data/site.js ─── */

const areaServed = CIDADES.map((nome) => ({
  '@type': 'City',
  name: nome,
  containedInPlace: { '@type': 'State', name: 'Rio de Janeiro' },
}));

const organizacao = {
  '@type': ['Organization', 'LocalBusiness', 'InternetServiceProvider'],
  '@id': `${SITE}/#organization`,
  name: EMPRESA.marca,
  legalName: EMPRESA.razaoSocial,
  taxID: EMPRESA.cnpj,
  foundingDate: EMPRESA.fundacao,
  description: `Provedor de internet por fibra óptica que atende ${CIDADES.join(', ')}. Planos de 600 Mega a 1 Giga com Wi-Fi 6, instalação grátis e sem fidelidade. No mercado desde ${EMPRESA.anoFundacao}.`,
  url: SITE,
  telephone: EMPRESA.telefones.comercial,
  priceRange: `R$ ${PRECO_MIN.replace('.', ',')} - R$ ${PRECO_MAX.replace('.', ',')}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: EMPRESA.endereco.logradouro,
    addressLocality: EMPRESA.endereco.cidade,
    addressRegion: EMPRESA.endereco.uf,
    postalCode: EMPRESA.endereco.cep,
    addressCountry: 'BR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: EMPRESA.geo.lat, longitude: EMPRESA.geo.lng },
  logo: { '@type': 'ImageObject', url: `${SITE}/img/logo.png` },
  image: `${SITE}/img/logo.png`,
  areaServed,
  sameAs: EMPRESA.perfis,
  contactPoint: [
    { '@type': 'ContactPoint', telephone: EMPRESA.telefones.comercial, contactType: 'sales', areaServed: 'BR', availableLanguage: 'Portuguese' },
    { '@type': 'ContactPoint', telephone: EMPRESA.telefones.suporte, contactType: 'technical support', areaServed: 'BR', availableLanguage: 'Portuguese' },
    { '@type': 'ContactPoint', telephone: EMPRESA.telefones.whatsapp, contactType: 'sales', contactOption: 'HearingImpairedSupported', areaServed: 'BR', availableLanguage: 'Portuguese' },
  ],
  openingHoursSpecification: HORARIOS.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dias,
    opens: h.abre,
    closes: h.fecha,
    description: h.setor,
  })),
};

const servicos = PLANOS.map((p) => ({
  '@type': 'Service',
  '@id': `${SITE}/#service-${p.id}`,
  serviceType: `Internet de Fibra Óptica ${p.nome}`,
  provider: { '@id': `${SITE}/#organization` },
  areaServed,
  offers: {
    '@type': 'Offer',
    price: p.preco,
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: `${SITE}/#Plans`,
    priceValidUntil: '2026-12-31',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: p.preco,
      priceCurrency: 'BRL',
      unitText: 'mês',
    },
    description: p.descricao,
  },
}));

const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: EMPRESA.marca,
  description: 'Internet de alta velocidade com fibra óptica',
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE}/#organization` },
};

const grafo: any[] = [organizacao, ...servicos, website];

if (breadcrumbs.length) {
  grafo.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.nome,
      item: new URL(c.url, base).href,
    })),
  });
}

if (faq.length) {
  grafo.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: f.resposta },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': grafo };
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Preconnect para APIs externas -->
    <link rel="preconnect" href="https://appgw.predialnet.com.br" />
    <link rel="preconnect" href="https://api.ipify.org" />

    <!-- Preload das fontes -->
    <link rel="preload" href="/fonts/Swis721 Lt BT Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Swis721 BT Roman.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Indexação -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="author" content="Predialnet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Predialnet" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WH2TDC4S');</script>
    <!-- End Google Tag Manager -->

    <!-- Schema.org — gerado a partir de src/data/site.js -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
  </head>
  <body class="bg-white text-black">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WH2TDC4S"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <a href="#main-content" class="skip-to-main">Pular para o conteúdo principal</a>
    <main id="main-content">
      <slot />
    </main>

    {SHOW_CARNAVAL_POPUP && (
      <>
        <div
          id="carnaval-popup"
          class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/70 p-4"
          role="dialog"
          aria-modal="true"
          aria-label="Aviso de horário de Carnaval"
        >
          <div class="relative w-full max-w-xl md:max-w-2xl lg:max-w-3xl">
            <button
              id="carnaval-popup-close"
              type="button"
              class="absolute right-5 top-3 text-white"
              aria-label="Fechar aviso"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5 md:h-8 md:w-8"
                aria-hidden="true"
              >
                <path d="M5 5L19 19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                <path d="M19 5L5 19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
              </svg>
            </button>
            <img
              src="/img/horarioCarnaval.webp"
              alt="Aviso de horário de atendimento no Carnaval"
              class="h-auto max-h-[90vh] w-full rounded-xl object-contain"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <script is:inline>
          (() => {
            const popup = document.getElementById('carnaval-popup');
            const closeButton = document.getElementById('carnaval-popup-close');

            if (!popup || !closeButton) return;

            const closePopup = () => {
              popup.remove();
            };

            closeButton.addEventListener('click', closePopup);

            popup.addEventListener('click', (event) => {
              if (event.target === popup) {
                closePopup();
              }
            });

            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') {
                closePopup();
              }
            });
          })();
        </script>
      </>
    )}

    {SHOW_INSTABILITY_POPUP && (
      <>
        <div
          id="instability-popup"
          class="font-sans fixed inset-0 bg-[#f2f2f2] md:bg-black md:bg-opacity-50 flex items-center justify-center z-[10000]"
          role="dialog"
          aria-modal="true"
          aria-label="Aviso de instabilidade"
        >
          <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl relative mx-4 overflow-hidden">

            <div class="px-6 md:px-12 pt-8 pb-8">

              <!-- Botão fechar -->
              <button
                id="instability-popup-close"
                type="button"
                class="absolute top-2 right-4 text-gray-400 text-4xl font-thin leading-none"
                aria-label="Fechar aviso"
              >&times;</button>

              <!-- Logo + título -->
              <div class="flex flex-row items-start justify-between mb-6">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest" style="color:#9c0004;">Aviso importante</p>
                  <h2 class="text-2xl md:text-3xl font-bold leading-tight mt-1" style="color:#9c0004;">Instabilidade no serviço</h2>
                </div>
                <img src="/img/logo.avif" alt="Predialnet" width="140" height="36" class="object-contain hidden sm:block" />
              </div>

              <!-- Corpo -->
              <div class="text-left text-black flex flex-col gap-3">
                <p class="text-sm md:text-base">
                  Prezados clientes, estamos passando por um momento de instabilidade. Nossa equipe já está trabalhando para resolver o mais rápido possível.
                </p>
                <p class="text-sm md:text-base">
                  Agradecemos a compreensão.
                </p>
              </div>

              <!-- CTA -->
              <div class="mt-6 flex justify-center">
                <button
                  id="instability-popup-close-bottom"
                  type="button"
                  class="bg-[#ffbd17] text-black py-2 px-8 rounded-full text-sm font-semibold active:scale-95 md:hover:scale-105 transition-transform shadow-md"
                >
                  Entendido
                </button>
              </div>

            </div>
          </div>
        </div>

        <script is:inline>
          (() => {
            const popup = document.getElementById('instability-popup');
            const closeBtn = document.getElementById('instability-popup-close');
            const closeBtnBottom = document.getElementById('instability-popup-close-bottom');

            if (!popup) return;

            const closePopup = () => {
              popup.remove();
              const fraudPopup = document.getElementById('fraud-popup');
              if (fraudPopup) {
                fraudPopup.style.display = 'flex';
              }
            };

            if (closeBtn) closeBtn.addEventListener('click', closePopup);
            if (closeBtnBottom) closeBtnBottom.addEventListener('click', closePopup);

            popup.addEventListener('click', (e) => {
              if (e.target === popup) closePopup();
            });

            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') closePopup();
            });
          })();
        </script>
      </>
    )}

    {SHOW_FRAUD_POPUP && (
      <>
        <div
          id="fraud-popup"
          class="font-sans fixed inset-0 bg-[#f2f2f2] md:bg-black md:bg-opacity-50 flex items-center justify-center z-[9999]"
          style={SHOW_INSTABILITY_POPUP ? "display:none" : ""}
          role="dialog"
          aria-modal="true"
          aria-label="Alerta de fraude"
        >
          <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl relative overflow-y-auto mx-4 max-h-[90%]">

            <!-- Marca d'água -->
            <div class="absolute inset-0 opacity-20 md:opacity-50 flex items-center justify-center z-0 pointer-events-none">
              <img src="/img/bg-mark.avif" alt="" width="350" height="350" style="object-fit:cover;" aria-hidden="true" />
            </div>

            <div class="relative z-10 px-6 md:px-12 pt-8 pb-8">

              <!-- Botão fechar -->
              <button
                id="fraud-popup-close"
                type="button"
                class="absolute top-2 right-4 text-gray-400 text-4xl font-thin leading-none"
                aria-label="Fechar aviso"
              >&times;</button>

              <!-- Logo + título -->
              <div class="flex flex-row items-start justify-between mb-6">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest" style="color:#9c0004;">Comunicado Importante</p>
                  <h2 class="text-xl md:text-2xl font-bold leading-tight mt-1" style="color:#9c0004;">Alerta de Fraude</h2>
                  <p class="text-sm text-black font-semibold mt-0.5">Pagamento via PIX e Boleto</p>
                </div>
                <img src="/img/logo.avif" alt="Predialnet" width="140" height="36" class="object-contain hidden sm:block" />
              </div>

              <!-- Corpo -->
              <div class="text-left text-black flex flex-col gap-3">
                <p class="text-sm md:text-base">
                  Recebemos relatos de mensagens encaminhadas a clientes através de <strong>páginas falsas e perfis de WhatsApp fraudulentos</strong>, com tentativas de obter ganhos mediante fraude, contendo chaves PIX e/ou links para pagamento apresentados como se fossem cobranças desta empresa.
                </p>
                <p class="text-sm md:text-base">
                  Em razão dessas tentativas de fraude, comunicamos a todos os clientes para se prevenirem quanto a estas ações nefastas. Pedimos que observem as seguintes orientações:
                </p>

                <div class="border-l-4 pl-4 flex flex-col gap-2 my-1" style="border-color:#9c0004;">
                  <p class="text-sm font-bold" style="color:#9c0004;">Como se proteger:</p>
                  <ul class="flex flex-col gap-1.5 text-sm text-black">
                    <li>· Não clique em links nem abra anexos de e-mails suspeitos.</li>
                    <li>· Não pague boletos nem realize PIX a partir de mensagens não oficiais.</li>
                    <li>· Antes de efetuar qualquer pagamento, confira o beneficiário/destinatário (razão social/nome e CNPJ/CPF).</li>
                    <li>· Ao processar seus pagamentos, atente-se ao beneficiário. Todas as nossas cobranças possuem como beneficiário a nossa razão social: <strong>Predlink Rede de Telecomunicações Ltda.</strong></li>
                    <li>· Em caso de dúvida, entre em contato conosco pelos canais oficiais da empresa e desconsidere mensagens suspeitas.</li>
                  </ul>
                </div>

                <p class="text-sm text-black mt-1">
                  <strong>Predialnet - Predlink Rede de Telecomunicações Ltda.</strong><br />
                  (21) 3515-0555
                </p>
              </div>

              <!-- CTA -->
              <div class="mt-6 flex justify-center">
                <button
                  id="fraud-popup-close-bottom"
                  type="button"
                  class="bg-[#ffbd17] text-black py-2 px-8 rounded-full text-sm font-semibold active:scale-95 md:hover:scale-105 transition-transform shadow-md"
                >
                  Entendido
                </button>
              </div>

            </div>
          </div>
        </div>

        <script is:inline>
          (() => {
            const popup = document.getElementById('fraud-popup');
            const closeBtn = document.getElementById('fraud-popup-close');
            const closeBtnBottom = document.getElementById('fraud-popup-close-bottom');

            if (!popup) return;

            const closePopup = () => { popup.remove(); };

            if (closeBtn) closeBtn.addEventListener('click', closePopup);
            if (closeBtnBottom) closeBtnBottom.addEventListener('click', closePopup);

            popup.addEventListener('click', (e) => {
              if (e.target === popup) closePopup();
            });

            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') closePopup();
            });
          })();
        </script>
      </>
    )}
  </body>
</html>
