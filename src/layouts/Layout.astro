---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Predialnet - Sua nova internet',
  description = 'Internet de alta velocidade com fibra óptica. Planos de 600 mega, 800 mega e 1 giga com Wi-Fi 6.'
} = Astro.props;

const SHOW_CARNAVAL_POPUP = false;
const SHOW_INSTABILITY_POPUP = false;
const SHOW_FRAUD_POPUP = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    
    <!-- Preconnect para APIs externas -->
    <link rel="preconnect" href="https://appgw.predialnet.com.br" />
    <link rel="preconnect" href="https://api.ipify.org" />
    
    <!-- Preload das fontes -->
    <link rel="preload" href="/fonts/Swis721 Lt BT Light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Swis721 BT Roman.ttf" as="font" type="font/ttf" crossorigin />
    
    <!-- Preload de imagens hero (primeiro banner do carrossel) -->
    <link rel="preload" href="/img/banner1.avif" as="image" type="image/avif" media="(min-width: 900px)" />
    <link rel="preload" href="/img/banner1.webp" as="image" type="image/webp" media="(min-width: 900px)" />
    <link rel="preload" href="/img/banner1Mobile.avif" as="image" type="image/avif" media="(max-width: 899px)" />
    <link rel="preload" href="/img/banner1Mobile.webp" as="image" type="image/webp" media="(max-width: 899px)" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.predialnet.com.br" />
    
    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Predialnet" />
    <meta name="keywords" content="internet fibra óptica, wi-fi 6, planos internet rio de janeiro, internet alta velocidade, internet niterói, provedor de internet" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Predialnet" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WH2TDC4S');</script>
    <!-- End Google Tag Manager -->
    
    <!-- Schema.org JSON-LD -->
