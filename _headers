# Configuração de Headers de Segurança para Netlify

/*
  # Prevenção de clickjacking
  X-Frame-Options: DENY
  
  # Prevenir MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Proteção XSS (legado, mas mantido para browsers antigos)
  X-XSS-Protection: 1; mode=block
  
  # Política de referrer
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissões de APIs do navegador
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # HSTS - Force HTTPS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Content Security Policy - Proteção contra XSS e injeção de código
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.whatsapp.com https://www.predialnet.com.br https://appgw.predialnet.com.br https://api.ipify.org https://speedtest.predialnet.com.br; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.predialnet.com.br https://appgw.predialnet.com.br; frame-ancestors 'none'; upgrade-insecure-requests;

# Cache para assets estáticos (imagens, fontes, etc)
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache para arquivos JS e CSS com hash no nome
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache mais curto para HTML
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
